#!/usr/bin/env bash
set -euo pipefail
CAISO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$CAISO_ROOT"
if [[ ! -x .venv/bin/python ]]; then
  echo "Create this project's .venv and install: pip install -e '.[benchmarks,train]'" >&2
  exit 1
fi
exec .venv/bin/python -m scripts.caiso_cli "$@"
