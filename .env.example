# Copy to .env in the repository root. Only credentials/models/service URLs belong here.
LLM_BACKEND=azure
AZURE_API_KEY=YOUR_AZURE_KEY
AZURE_API_BASE=https://YOUR_RESOURCE.openai.azure.com/
AZURE_API_VERSION=2024-10-21

# Azure deployment names (not URLs). Keep the underlying models the same for comparisons.
AZURE_GPT_4O_DEPLOYMENT=YOUR_GPT4O_DEPLOYMENT
AZURE_GPT_4O_MINI_DEPLOYMENT=YOUR_GPT4O_MINI_DEPLOYMENT
AZURE_TEXT_EMBEDDING_3_SMALL_DEPLOYMENT=YOUR_EMBEDDING_DEPLOYMENT

# Method models; benchmark task models retain their original identifiers.
CAISO_METHOD_MODEL=gpt-4o
CAISO_EMBEDDING_MODEL=text-embedding-3-small

# HotpotQA retriever: full ColBERT search endpoint, including its route.
# For a local server replace this with e.g. http://localhost:2017/wiki17_abstracts
COLBERT_URL=http://20.102.90.50:2017/wiki17_abstracts

# Optional: PubMed model search also includes these models. Configure deployments
# for every candidate you want to evaluate; missing mappings raise a clear error.
# AZURE_GPT_3_5_TURBO_0125_DEPLOYMENT=...
# AZURE_GPT_4_TURBO_DEPLOYMENT=...
# Claude candidates require a separate supported provider; Azure OpenAI cannot host them.

# Optional Amazon external vLLM service (original defaults shown):
# VLLM_HOST=localhost
# VLLM_PORT=8877
